"use client";

import { useState, useMemo } from 'react'
import useSWR from 'swr'
import { motion, AnimatePresence } from 'framer-motion'
import { 
  Users, 
  Search, 
  MessageSquare, 
  Calendar, 
  Phone, 
  Loader2, 
  Star, 
  Clock, 
  ArrowRight,
  Filter
} from 'lucide-react'

// Generic fetcher for SWR
const fetcher = (url: string) => fetch(url).then(r => r.json())

interface Client {
  id: string
  name?: string
  phone: string
  tags?: string[]
  last_contact?: string
  conversation_count?: number
  total_visits?: number
  total_spent?: number
}

function timeAgo(iso: string) {
  if (!iso) return '—'
  const date = new Date(iso)
  const now = new Date()
  const diffInMs = now.getTime() - date.getTime()
  const diffInDays = Math.floor(diffInMs / (1000 * 60 * 60 * 24))
  
  if (diffInDays === 0) return 'Hoje'
  if (diffInDays === 1) return 'Ontem'
  if (diffInDays < 7) return `${diffInDays}d atrás`
  return date.toLocaleDateString('pt-BR')
}

export default function ClientsPage() {
  const [search, setSearch] = useState('')
  const [selectedId, setSelectedId] = useState<string | null>(null)

  // Fetch list of clients
  const { data: clientsData, error: clientsError, isLoading: clientsLoading } = useSWR<Client[]>('/api/clients', fetcher, {
    refreshInterval: 30000 // Refresh every 30s
  })

  // Fetch selected client detail
  const { data: detailData, isLoading: detailLoading } = useSWR(
    selectedId ? `/api/clients/${selectedId}` : null, 
    fetcher
  )

  const clients = Array.isArray(clientsData) ? clientsData : []

  const filtered = useMemo(() => {
    return clients.filter(c =>
      !search || 
      c.name?.toLowerCase().includes(search.toLowerCase()) || 
      c.phone?.includes(search)
    )
  }, [clients, search])

  const selectedClient = useMemo(() => {
    return clients.find(c => c.id === selectedId)
  }, [clients, selectedId])

  return (
    <div className="flex flex-col h-[calc(100vh-120px)] gap-6">
      {/* Header Soberano */}
      <div className="flex items-center justify-between">
        <motion.div 
          initial={{ opacity: 0, x: -20 }}
          animate={{ opacity: 1, x: 0 }}
        >
          <h1 className="text-3xl font-bold text-gray-900 tracking-tight flex items-center gap-3">
            <Users className="w-8 h-8 text-primary" />
            Base de Inteligência: Clientes
          </h1>
          <p className="text-gray-500 mt-1 text-sm font-medium">
            Gestão unificada de perfis e interações WhatsApp
          </p>
        </motion.div>
        
        <div className="flex items-center gap-3">
          <div className="hidden md:flex flex-col items-end px-4 border-r border-gray-200">
            <span className="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Sincronizado</span>
            <span className="text-xl font-bold text-primary">{clients.length}</span>
          </div>
          <button className="bg-primary text-white px-4 py-2 rounded-xl font-semibold flex items-center gap-2 hover:bg-primary-dark transition-all shadow-md active:scale-95">
            <Filter className="w-4 h-4" />
            <span>Filtros Avançados</span>
          </button>
        </div>
      </div>

      <div className="flex flex-1 gap-6 min-h-0">
        {/* Lado Esquerdo: Listagem (Glassmorphism inspired) */}
        <div className="w-1/3 flex flex-col bg-white/80 backdrop-blur-sm rounded-3xl border border-white shadow-xl overflow-hidden">
          <div className="p-6 border-b border-gray-100/50 bg-gradient-to-b from-white to-gray-50/30">
            <div className="relative group">
              <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 group-focus-within:text-primary transition-colors" />
              <input 
                value={search} 
                onChange={e => setSearch(e.target.value)}
                placeholder="Buscar cliente..."
                className="w-full pl-12 pr-4 py-3 bg-white border border-gray-200 rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all shadow-inner" 
              />
            </div>
          </div>

          <div className="flex-1 overflow-y-auto p-4 space-y-2 custom-scrollbar">
            {clientsLoading ? (
              <div className="flex flex-col items-center justify-center h-full gap-4 text-gray-400">
                <Loader2 className="w-8 h-8 animate-spin text-primary" />
                <p className="text-sm font-medium animate-pulse">Sincronizando base...</p>
              </div>
            ) : filtered.length === 0 ? (
              <div className="flex flex-col items-center justify-center h-full py-12 text-center">
                <div className="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mb-4">
                  <Users className="w-8 h-8 text-gray-200" />
                </div>
                <p className="text-gray-900 font-bold">Nenhum cliente encontrado</p>
                <p className="text-sm text-gray-400 max-w-[200px] mt-1">
                  Tente ajustar os filtros ou aguarde novas mensagens.
                </p>
              </div>
            ) : (
              <AnimatePresence initial={false}>
                {filtered.map((client, idx) => (
                  <motion.button 
                    key={client.id} 
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: idx * 0.03 }}
                    onClick={() => setSelectedId(client.id)}
                    className={`w-full text-left flex items-center gap-4 p-4 rounded-2xl transition-all relative group ${
                      selectedId === client.id 
                      ? 'bg-primary text-white shadow-lg shadow-primary/20 ring-1 ring-white/20' 
                      : 'hover:bg-primary/5 hover:translate-x-1 border border-transparent'
                    }`}
                  >
                    <div className={`w-12 h-12 rounded-full flex items-center justify-center text-lg font-bold shadow-soft transition-transform group-hover:scale-105 ${
                      selectedId === client.id 
                      ? 'bg-white/20 text-white' 
                      : 'bg-grad-premium text-white'
                    }`}>
                      {client.name?.[0]?.toUpperCase() || '?'}
                    </div>
                    
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center justify-between gap-2">
                        <p className="font-bold truncate">{client.name || 'Sem nome'}</p>
                        {client.conversation_count && client.conversation_count > 5 && (
                          <Star className={`w-3 h-3 fill-current ${selectedId === client.id ? 'text-white' : 'text-yellow-400'}`} />
                        )}
                      </div>
                      <p className={`text-xs flex items-center gap-1.5 opacity-70 ${selectedId === client.id ? 'text-white' : 'text-gray-500 font-medium'}`}>
                        <Phone className="w-3 h-3" /> {client.phone}
                      </p>
                    </div>

                    <div className="text-right">
                      <p className={`text-[10px] font-bold uppercase tracking-tighter ${selectedId === client.id ? 'text-white/80' : 'text-gray-400'}`}>
                        {timeAgo(client.last_contact || '')}
                      </p>
                      {selectedId !== client.id && (
                        <ArrowRight className="w-3 h-3 text-primary/30 mt-1 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" />
                      )}
                    </div>
                  </motion.button>
                ))}
              </AnimatePresence>
            )}
          </div>
        </div>

        {/* Lado Direito: Dashboard do Cliente (Card-in-Card style) */}
        <div className="flex-1 bg-white rounded-3xl border border-gray-100 shadow-xl overflow-hidden flex flex-col relative">
          <AnimatePresence mode="wait">
            {!selectedId ? (
              <motion.div 
                key="empty"
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                className="flex-1 flex flex-col items-center justify-center text-center p-12 bg-grad-soft"
              >
                <div className="w-24 h-24 bg-white rounded-3xl shadow-xl flex items-center justify-center mb-6 animate-bounce">
                  <Users className="w-12 h-12 text-primary/20" />
                </div>
                <h3 className="text-xl font-bold text-gray-900">Selecione um Cliente</h3>
                <p className="text-gray-500 mt-2 max-w-sm leading-relaxed">
                  Explore o histórico completo, analisando o comportamento, tendências de gastos e inteligência conversacional do cliente.
                </p>
              </motion.div>
            ) : (
              <motion.div 
                key={selectedId}
                initial={{ opacity: 0, x: 20 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, scale: 0.95 }}
                className="flex-1 flex flex-col min-h-0"
              >
                {/* Perfil Header */}
                <div className="p-8 bg-gradient-to-r from-primary to-primary-dark text-white relative overflow-hidden">
                  <div className="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl opacity-50" />
                  
                  <div className="flex items-center gap-6 relative z-10">
                    <div className="w-24 h-24 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20 p-1 shadow-2xl">
                        <div className="w-full h-full rounded-2xl bg-white text-primary flex items-center justify-center text-3xl font-black">
                            {selectedClient?.name?.[0]?.toUpperCase() || '?'}
                        </div>
                    </div>
                    <div>
                      <div className="flex items-center gap-3">
                        <h2 className="text-3xl font-black tracking-tight">{selectedClient?.name || 'Cliente Sem Nome'}</h2>
                        <span className="bg-white/20 backdrop-blur-md text-[10px] px-2 py-0.5 rounded-full font-bold uppercase border border-white/10">Nível Platina</span>
                      </div>
                      <div className="flex items-center gap-4 mt-2">
                        <div className="flex items-center gap-1.5 bg-white/10 px-3 py-1 rounded-full text-xs font-bold border border-white/5">
                            <Phone className="w-3 h-3" /> {selectedClient?.phone}
                        </div>
                        <div className="flex items-center gap-1.5 bg-white/10 px-3 py-1 rounded-full text-xs font-bold border border-white/5">
                            <Clock className="w-3 h-3" /> Criado em {timeAgo(selectedClient?.last_contact || '')}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Sub-Tabs / KPIs do Cliente */}
                <div className="p-8 space-y-8 flex-1 overflow-y-auto custom-scrollbar">
                  <div className="grid grid-cols-3 gap-6">
                    <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }} className="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm group hover:border-primary/50 transition-all">
                      <div className="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <MessageSquare className="w-5 h-5 text-primary" />
                      </div>
                      <p className="text-xs font-bold text-gray-400 uppercase tracking-widest">Interações</p>
                      <p className="text-2xl font-black text-gray-900">{selectedClient?.conversation_count || 0}</p>
                    </motion.div>
                    <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }} className="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm group hover:border-blue-500/50 transition-all">
                      <div className="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <Calendar className="w-5 h-5 text-blue-500" />
                      </div>
                      <p className="text-xs font-bold text-gray-400 uppercase tracking-widest">Visitas</p>
                      <p className="text-2xl font-black text-gray-900">{selectedClient?.total_visits || 0}</p>
                    </motion.div>
                    <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }} className="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm group hover:border-purple-500/50 transition-all">
                      <div className="w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <Star className="w-5 h-5 text-purple-500" />
                      </div>
                      <p className="text-xs font-bold text-gray-400 uppercase tracking-widest">Ticket Médio</p>
                      <p className="text-2xl font-black text-gray-900">R$ {selectedClient?.total_spent ? (selectedClient.total_spent / (selectedClient.total_visits || 1)).toFixed(2) : '0.00'}</p>
                    </motion.div>
                  </div>

                  {/* Detail Intelligence Section */}
                  <div className="bg-gray-50/50 rounded-3xl border border-gray-100 p-6">
                    <div className="flex items-center justify-between mb-6">
                        <h4 className="font-black text-gray-900 flex items-center gap-2">
                            <Zap className="w-4 h-4 text-primary" />
                            Live Insight Engine
                        </h4>
                        <div className="flex items-center gap-2 bg-white px-3 py-1 rounded-full border border-gray-100 shadow-sm">
                            <span className="w-2 h-2 bg-green-500 rounded-full animate-pulse" />
                            <span className="text-[10px] font-bold text-gray-400">Sync Ativo</span>
                        </div>
                    </div>

                    {detailLoading ? (
                        <div className="flex items-center justify-center py-12">
                            <Loader2 className="w-6 h-6 animate-spin text-primary opacity-50" />
                        </div>
                    ) : (
                        <div className="space-y-4">
                            {/* Conversations History Mock-ish (or real if detail exists) */}
                            {(!detailData?.conversations || detailData.conversations.length === 0) ? (
                                <div className="p-8 text-center text-gray-400 bg-white rounded-2xl border border-dashed border-gray-200">
                                    Nenhuma conversa registrada nos logs do cérebro.
                                </div>
                            ) : (
                                <div className="grid gap-3">
                                    {detailData.conversations.slice(0, 3).map((conv: any) => (
                                        <div key={conv.id} className="bg-white p-4 rounded-xl border border-gray-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
                                            <div className="flex items-center gap-3">
                                                <div className="w-2 h-10 bg-primary/20 rounded-full" />
                                                <div>
                                                    <p className="text-sm font-bold text-gray-900">Protocolo #{conv.id.slice(0, 8)}</p>
                                                    <p className="text-xs text-gray-400">{new Date(conv.started_at).toLocaleString()}</p>
                                                </div>
                                            </div>
                                            <span className="text-[10px] font-bold bg-primary/5 text-primary px-2 py-0.5 rounded-md uppercase tracking-wider">Resolvido AI</span>
                                        </div>
                                    ))}
                                    <button className="w-full py-2 text-xs font-bold text-primary hover:underline transition-all">
                                        Ver histórico completo
                                    </button>
                                </div>
                            )}
                        </div>
                    )}
                  </div>
                </div>

                {/* Footer Action */}
                <div className="p-6 bg-white border-t border-gray-100 flex items-center justify-between">
                    <button className="text-xs font-bold text-gray-400 hover:text-gray-900 transition-colors uppercase tracking-widest">
                        Exportar Relatório Geral
                    </button>
                    <div className="flex items-center gap-2">
                        <button className="px-6 py-3 bg-gray-50 border border-gray-200 rounded-2xl text-xs font-bold text-gray-900 hover:bg-gray-100 transition-all active:scale-95">
                            Arquivar Perfil
                        </button>
                        <button className="px-6 py-3 bg-primary text-white rounded-2xl text-xs font-bold hover:bg-primary-dark transition-all shadow-md active:scale-95 flex items-center gap-2">
                            Enviar WhatsApp
                            <ArrowRight className="w-4 h-4" />
                        </button>
                    </div>
                </div>
              </motion.div>
            )}
          </AnimatePresence>
        </div>
      </div>
    </div>
  )
}
