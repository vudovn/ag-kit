# ==============================
# LUNA OS v3.0 — Environment Template
# Copie para .env e preencha os valores reais
# NUNCA commite o .env real (está no .gitignore)
# ==============================

# ===== STACK EXISTENTE =====

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyxxxxx

# AI / LLM
ANTHROPIC_API_KEY=sk-xxxxx
OPENROUTER_API_KEY=sk-or-xxxxx

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://command-tower-evo-api:8080
EVOLUTION_API_KEY=mothership_master_2026
EVOLUTION_INSTANCE=haven

# Webhook Security (HMAC)
WEBHOOK_API_KEY=change_me_in_production_min_32chars

# Frontend
NEXT_PUBLIC_API_URL=http://luna-backend:8000
NEXT_PUBLIC_EVOLUTION_MANAGER_URL=http://localhost:8081

# Belasis ERP
BELASIS_API_URL=https://api.belasis.com.br
BELASIS_API_KEY=
BELASIS_MOCK=true

# App Config
ENV=development
LUNA_MODE=active
APP_DEBUG=false

# ===== NOVA STACK v3.0 =====

# Redis (Queue & Cache)
REDIS_URL=redis://command-tower-redis:6379/0

# Milvus (Vector Database)
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Jaeger (Distributed Tracing)
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# Ntfy (Alertas Push)
NTFY_TOPIC=luna-alerts
NTFY_BASE_URL=https://ntfy.sh

# Monitoring Stack
GRAFANA_PASSWORD=change_me_grafana
PGADMIN_EMAIL=admin@luna.local
PGADMIN_PASSWORD=change_me_pgadmin

# Database Interna (se usar Postgres local ao invés de Supabase)
DB_USER=luna_user
DB_PASSWORD=change_me_db_password
POSTGRES_DB=luna

# Windmill (Workflow Automation - Opcional)
# WINDMILL_HOST=windmill:8000
# WINDMILL_TOKEN=secret_token
