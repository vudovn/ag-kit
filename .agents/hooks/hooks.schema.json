{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-kit.dev/schemas/antigravity-hooks.schema.json",
  "title": "AG Kit Antigravity Native Hooks",
  "type": "object",
  "patternProperties": {
    "^[A-Za-z0-9._-]+$": {
      "$ref": "#/$defs/hookDefinition"
    }
  },
  "properties": {
    "$schema": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "hookDefinition": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "PreToolUse": {
          "type": "array",
          "items": {"$ref": "#/$defs/matchedEvent"}
        },
        "PostToolUse": {
          "type": "array",
          "items": {"$ref": "#/$defs/matchedEvent"}
        },
        "PreInvocation": {
          "type": "array",
          "items": {"$ref": "#/$defs/handler"}
        },
        "PostInvocation": {
          "type": "array",
          "items": {"$ref": "#/$defs/handler"}
        },
        "Stop": {
          "type": "array",
          "items": {"$ref": "#/$defs/handler"}
        }
      },
      "additionalProperties": false
    },
    "matchedEvent": {
      "type": "object",
      "required": ["matcher", "hooks"],
      "properties": {
        "matcher": {"type": "string"},
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/handler"}
        }
      },
      "additionalProperties": false
    },
    "handler": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "type": {"type": "string", "enum": ["command"]},
        "command": {"type": "string", "minLength": 1},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 300}
      },
      "additionalProperties": false
    }
  }
}
